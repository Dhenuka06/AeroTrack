# Root Environment Configuration Example

# Backend Server Port
PORT=5000

# MongoDB URI (Supports local MongoDB or auto-fallback to MongoDB Memory Server)
MONGODB_URI=mongodb://127.0.0.1:27017/aqi_aggregator

# Public AQI API Key (Optional. If omitted, Open-Meteo Air Quality API is used by default with zero key requirement)
WAQI_API_KEY=your_waqi_api_key_here

# Cron Schedule Expression (Default: every 15 minutes)
CRON_SCHEDULE=*/15 * * * *
