# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Defaults to local or automatic in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/aqi_aggregator

# Optional: WAQI API Key (If omitted or left default, Open-Meteo Air Quality API is used with zero key requirement)
WAQI_API_KEY=your_waqi_api_key_here

# Cron schedule interval for data collector (Default: every 15 minutes)
CRON_SCHEDULE=*/15 * * * *
